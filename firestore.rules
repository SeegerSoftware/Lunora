rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerByUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownerMatchesUserIdOnCreate() {
      return isSignedIn() &&
          request.resource.data.userId is string &&
          request.resource.data.userId == request.auth.uid;
    }

    function ownerMatchesUserId() {
      return isSignedIn() &&
          resource.data.userId is string &&
          resource.data.userId == request.auth.uid;
    }

    function ownerMatchesOnWrite() {
      return ownerMatchesUserIdOnCreate() &&
          (!('userId' in resource.data) || resource.data.userId == request.auth.uid);
    }

    // Profil utilisateur principal.
    match /users/{userId} {
      allow read: if isOwnerByUid(userId);
      allow create: if isOwnerByUid(userId) &&
          request.resource.data.id == request.auth.uid &&
          request.resource.data.subscriptionStatus == 'none' &&
          request.resource.data.selectedPlan == null &&
          !('isAdmin' in request.resource.data);
      // Subscription and account lifecycle changes go through the backend.
      allow update, delete: if false;
    }

    // Donnees enfant (1 profil par enfant).
    match /children_profiles/{childId} {
      allow read: if ownerMatchesUserId();
      allow create: if ownerMatchesUserIdOnCreate();
      allow update: if ownerMatchesOnWrite();
      allow delete: if ownerMatchesUserId();
    }

    // Histoires generees.
    match /stories/{storyId} {
      allow read: if ownerMatchesUserId();
      allow create: if ownerMatchesUserIdOnCreate();
      allow update: if ownerMatchesUserId() &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['userFeedback', 'userFeedbackAt']) &&
          request.resource.data.userFeedback in [-1, 1];
      allow delete: if ownerMatchesUserId();
    }

    // Etat des series par enfant.
    match /child_series_state/{childId} {
      allow read: if ownerMatchesUserId();
      allow create: if ownerMatchesUserIdOnCreate();
      allow update: if ownerMatchesOnWrite();
      allow delete: if ownerMatchesUserId();
    }

    // Abonnement utilisateur.
    match /subscriptions/{userId} {
      allow read: if isOwnerByUid(userId);
      // Stripe webhooks write with Firebase Admin and bypass client rules.
      allow create, update, delete: if false;
    }

    // Memoire narrative long terme.
    match /story_worlds/{worldId} {
      allow read: if ownerMatchesUserId();
      allow create: if ownerMatchesUserIdOnCreate();
      allow update: if ownerMatchesOnWrite();
      allow delete: if ownerMatchesUserId();
    }

    // Snapshots de memoire par histoire.
    match /story_memory_snapshots/{snapshotId} {
      allow read: if ownerMatchesUserId();
      allow create: if ownerMatchesUserIdOnCreate();
      allow update: if ownerMatchesOnWrite();
      allow delete: if ownerMatchesUserId();
    }

    // Jetons FCM propres a chaque appareil connecte.
    match /notification_devices/{deviceId} {
      allow read: if ownerMatchesUserId();
      allow create: if ownerMatchesUserIdOnCreate();
      allow update: if ownerMatchesOnWrite();
      allow delete: if ownerMatchesUserId();
    }

    // Reserve cote backend uniquement: un quota quotidien par enfant.
    match /story_daily_quotas/{quotaId} {
      allow read, create, update, delete: if false;
    }

    // Evenements produit minimaux, sans donnees sensibles enfant.
    match /product_analytics_events/{eventId} {
      allow create: if ownerMatchesUserIdOnCreate() &&
          request.resource.data.eventName is string;
      allow read, update, delete: if false;
    }

    // Dashboard IA prive, ecrit exclusivement par le backend Admin SDK.
    match /story_generation_metrics/{metricId} {
      allow read, create, update, delete: if false;
    }

    match /story_generation_daily/{dateKey} {
      allow read, create, update, delete: if false;
    }
  }
}
